{
  "name": "jungle-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "worker": "bun src/worker.ts",
    "migrate": "bun scripts/migrate.ts up",
    "migrate:down": "bun scripts/migrate.ts down",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:integration": "bun test --timeout 60000 tests/integration",
    "test:all": "bun run typecheck && bun run test && bun run test:integration",
    "demo": "bun scripts/demo.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.900.0",
    "@mikro-orm/core": "6.6.8",
    "@mikro-orm/postgresql": "6.6.8",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/express": "^5.0.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.3"
  }
}
